# LeadFlow Backend Environment Configuration
PROJECT_NAME="LeadFlow — Lead Management System"
VERSION="1.0.0"
ENVIRONMENT="development"

# Database connection:
# For local dev without PostgreSQL, SQLite is supported out of the box:
DATABASE_URL="sqlite:///./leadflow.db"
# For PostgreSQL (Docker, local, Supabase, Neon, Render):
# DATABASE_URL="postgresql+psycopg://leadflow_user:leadflow_password@localhost:5432/leadflow"

# Security & JWT:
# Replace with a cryptographically secure random string in production (e.g. openssl rand -hex 32)
SECRET_KEY="leadflow-development-secret-key-min-32-chars-length"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS Origins (JSON array of strings)
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "https://leadflow.vercel.app"]'

# Demo account seed configuration
DEMO_USER_EMAIL="demo@swandigital.com"
DEMO_USER_PASSWORD="DemoPassword123!"
DEMO_ADMIN_EMAIL="admin@swandigital.com"
DEMO_ADMIN_PASSWORD="AdminPassword123!"
